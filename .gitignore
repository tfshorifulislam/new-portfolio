# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files - these hold the server-only GITHUB_TOKEN, so they must never
# be committed.
.env
.env.local
.env.*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# lock
# package-lock.json is committed: CI installs with `npm ci`, which requires it.
pnpm-lock.yaml
yarn.lock

# Logs
*.log

# Superpowers brainstorming session artifacts
.superpowers/

# Internal planning artifacts (specs, phase plans, brainstorming sessions)
docs/superpowers/
# Playwright MCP + design screenshots (local only)
.playwright-mcp/
desktop-full.png
mobile-hero.png
*.playwright.png
# Root-level verification screenshots (rt-*, menu-*, resp-*, fix-*, chip*, etc.)
/*.png
